@model IEnumerable<Provider>

@{
    ViewData["Title"] = "Deleted Providers";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>@ViewData["Title"]</h1>
        <a asp-action="Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Back to Active Providers
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <div class="table-responsive">
        @if (!Model.Any())
        {
            <div class="alert alert-info" role="alert">
                <i class="bi bi-info-circle"></i> No deleted providers found.
            </div>
        }
        else
        {
            <table class="table table-hover table-striped">
                <thead class="table-dark">
                    <tr>
                        <th>Provider Name</th>
                        <th>County</th>
                        <th>Status</th>
                        <th>Deleted Date</th>
                        <th class="text-center">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="table-danger opacity-75">
                            <td>
                                <strong>@Html.DisplayFor(modelItem => item.ProviderName)</strong>
                            </td>
                            <td>@Html.DisplayFor(modelItem => item.County)</td>
                            <td>
                                @if (item.Status == "Active")
                                {
                                    <span class="badge bg-success">@item.Status</span>
                                }
                                else if (item.Status == "Inactive")
                                {
                                    <span class="badge bg-secondary">@item.Status</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning">@item.Status</span>
                                }
                            </td>
                            <td>
                                @if (item.DeletedAt.HasValue)
                                {
                                    @item.DeletedAt.Value.ToString("yyyy-MM-dd HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="text-center">
                                <div class="btn-group" role="group">
                                    <a asp-action="Restore" asp-route-id="@item.ProviderId" class="btn btn-sm btn-success" title="Restore Provider">
                                        <i class="bi bi-arrow-counterclockwise"></i> Restore
                                    </a>
                                    <a asp-action="Details" asp-route-id="@item.ProviderId" class="btn btn-sm btn-info" title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
