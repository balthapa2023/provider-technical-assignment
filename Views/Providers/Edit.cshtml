@model ProviderAssignmentStarter.Models.Provider

@{
    ViewData["Title"] = "Edit Provider";
}

<h1>Edit Provider</h1>

<form asp-action="Edit" method="post">

    <!-- Keep the ProviderId so the controller knows which record to update. -->
    <input type="hidden" asp-for="ProviderId" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" />
        <span asp-validation-for="Name" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="County" class="form-label"></label>
        <input asp-for="County" class="form-control" />
        <span asp-validation-for="County" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Status" class="form-label"></label>

        <select asp-for="Status" class="form-select">
            <option value="Active">Active</option>
            <option value="Inactive">Inactive</option>
        </select>

        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>